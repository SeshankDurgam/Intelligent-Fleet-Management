# Backend configuration — copy to .env and adjust as needed.
# All values below are the defaults used when a variable is unset.

# HTTP port of the backend API
PORT=4000

# MQTT broker for device communication
MQTT_BROKER=mqtt://test.mosquitto.org:1883

# Eclipse Ditto gateway (host:port, no scheme)
DITTO_SERVER=localhost:8080
DITTO_USERNAME=ditto
DITTO_PASSWORD=ditto
